# Copy to .env. start.sh reads this file without executing its contents.
# Compose also loads this file into its container for named integration variables.
# For a different file, set AEGIS_CONFIG_ENV_FILE to that same path and use --env-file.
# Quote values containing $ with single quotes so Compose keeps them literal.
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8787
AEGIS_DATA_DIR=data
AEGIS_STORAGE_BACKEND=sqlite
# Docker only: set 1 and rebuild to include the locked PostgreSQL driver.
AEGIS_INSTALL_POSTGRES=0
# Direct container loopback probe Host; include this host in AEGIS_ALLOWED_HOSTS.
AEGIS_HEALTH_HOST=localhost
# PostgreSQL requires optional dependency and a schema prepared by aegis-init-postgres
# or SQLite transfer. CLI uses exported environment; it does not load .env.
# See docs/POSTGRES-STORAGE.md before selecting postgres.
# AEGIS_POSTGRES_SCHEMA=aegis_workspace
# AEGIS_POSTGRES_DSN=
AEGIS_ALLOWED_HOSTS=localhost,127.0.0.1
AEGIS_LAB_MODE=0
AEGIS_SECURE_COOKIE=0
# Required for Docker or remote first-time setup. Generate a random token.
AEGIS_SETUP_TOKEN=
# Optional: OpenAI-compatible chat completions provider.
AEGIS_LLM_BASE_URL=https://api.openai.com/v1
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=
AEGIS_LLM_CHAT_ENABLED=0
# Optional flat token price quotes; never credentials. See docs/LLM-COSTS.md.
AEGIS_LLM_PRICES=[]
# Authorization test credentials stay in server environment variables.
# Include the complete Authorization header value (e.g. Bearer ...).
AEGIS_TEST_USER=

# Execution limits shared across all tasks targeting the same origin.
# Restart after changing these values; pending plans require a fresh policy review.
AEGIS_TARGET_RPS=2
AEGIS_TARGET_PARALLEL=1
AEGIS_REQUEST_TIMEOUT=8
AEGIS_DNS_TIMEOUT=4
AEGIS_TASK_TIMEOUT=300
AEGIS_QUEUE_TIMEOUT=600
AEGIS_REQUEST_BUDGET=24
AEGIS_REQUEST_RETRIES=1
AEGIS_RETRY_DELAY=0.5
AEGIS_CONCURRENT_TASKS=2
AEGIS_PENDING_LIMIT=30

# Report downloads share admission slots across all authenticated users.
AEGIS_EXPORT_PARALLEL=2
AEGIS_EXPORT_TIMEOUT=120

# Optional configured ScopeSentry JWT read sources; see docs/SCOPESENTRY.md.
# Credentials belong in each connection's token_env, never in this JSON.
AEGIS_SCOPESENTRY_SOURCES=[]

# Optional fixed MCP endpoints and reviewed GET executors. See docs/MCP-EXECUTION.md.
# Put Bearer credentials and independent signing keys in the named environment variables.
# Registration alone never approves a task. Both defaults keep remote execution disabled.
AEGIS_MCP_CONNECTIONS=[]
AEGIS_MCP_EXECUTORS=[]

# Optional additional fixed model recipients (max10); URLs/keys remain in env vars.
# AEGIS_MODEL_DESTINATIONS=[{"id":"company","name":"Company models","base_env":"COMPANY_MODEL_BASE","key_env":"COMPANY_MODEL_KEY"}]
# COMPANY_MODEL_BASE=https://provider.example/v1
# COMPANY_MODEL_KEY=replace-locally
# Review profiles/defaults in the Model Profiles screen after changing credentials.
