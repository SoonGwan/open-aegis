# Copy to .env. start.sh reads this file without executing its contents.
AEGIS_HOST=127.0.0.1
AEGIS_PORT=8787
AEGIS_DATA_DIR=data
AEGIS_ALLOWED_HOSTS=localhost,127.0.0.1
AEGIS_LAB_MODE=0
AEGIS_SECURE_COOKIE=0
# Required for Docker or remote first-time setup. Generate a random token.
AEGIS_SETUP_TOKEN=
# Optional: OpenAI-compatible chat completions provider.
AEGIS_LLM_BASE_URL=https://api.openai.com/v1
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=
# Authorization test credentials stay in server environment variables.
# Include the complete Authorization header value (e.g. Bearer ...).
AEGIS_TEST_USER=
